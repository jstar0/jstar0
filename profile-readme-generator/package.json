{
  "name": "jstar-profile-readme-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.6.0",
    "pnpm": ">=10.15.0"
  },
  "scripts": {
    "generate": "node --experimental-strip-types src/cli.ts",
    "generate:static": "node --experimental-strip-types src/cli.ts --static",
    "generate:svg": "node --experimental-strip-types src/cli.ts --no-png",
    "editor": "node --experimental-strip-types src/editor-server.ts",
    "sync:github": "node --experimental-strip-types src/github-sync.ts",
    "qa:render": "node --experimental-strip-types src/qa-render.ts",
    "qa:motion": "node --experimental-strip-types src/qa-motion.ts",
    "qa:wave-collage": "node --experimental-strip-types src/qa-wave-collage.ts",
    "qa:diff": "node --experimental-strip-types src/qa-diff.ts",
    "qa:compat": "node --experimental-strip-types src/qa-compat.ts",
    "qa:pixel-edges": "node --experimental-strip-types src/qa-pixel-edges.ts",
    "qa": "pnpm qa:ci && pnpm qa:visual",
    "qa:ci": "pnpm typecheck && pnpm test:layout && pnpm test:readme && pnpm test:editor && pnpm test:data && pnpm test:github-sync && pnpm generate && pnpm generate:static && pnpm test:publish && pnpm qa:render && pnpm qa:motion && pnpm qa:compat && pnpm qa:pixel-edges",
    "qa:visual": "pnpm qa:wave-collage && pnpm qa:diff",
    "test:readme": "node --experimental-strip-types tests/readme.test.ts",
    "test:editor": "node --experimental-strip-types tests/editor.test.ts",
    "test:data": "node --experimental-strip-types tests/data-integrity.test.ts",
    "test:publish": "node --experimental-strip-types tests/publish.test.ts",
    "test:github-sync": "node --experimental-strip-types tests/github-sync.test.ts",
    "test:layout": "node --experimental-strip-types tests/layout.test.ts",
    "publish:profile": "node --experimental-strip-types src/publish.ts",
    "check:published": "node --experimental-strip-types src/publish.ts --check",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.60.0",
    "typescript": "^5.9.3"
  }
}
